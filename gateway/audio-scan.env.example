# /etc/scray/audio-scan.env  (chmod 600, owned by root)
# Copy this file there, fill in the three blanks. Never commit the real one.

# The audio api.php on Hostinger. Staging for now.
SCRAY_AUDIO_API=https://macnguyen.com/audio-staging/api.php

# audio_worker_key from scray_secrets.php (openssl rand -hex 32).
SCRAY_AUDIO_WORKER_KEY=

# The scanning sub-account: base /home/audio, WebDAV on, read-only OFF
# (a read-only account cannot list folders).
SCRAY_DAV_URL=https://u673373-sub4.your-storagebox.de
SCRAY_DAV_USER=u673373-sub4
SCRAY_DAV_PASS=

# Optional
#SCRAY_TAG_WORKERS=4
# Only walk one folder (a partial walk never marks anything as gone):
#SCRAY_SCAN_ROOT=Music/part f
# Stop after this many files, for a first look:
#SCRAY_SCAN_MAX=200
